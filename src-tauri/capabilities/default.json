{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "面板与图标窗所需的最小权限。核心能力（取词、UIA、翻译）全部走 Rust 侧自定义命令，不经前端权限。",
  "windows": ["panel", "icon", "settings", "history"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging"
  ]
}
